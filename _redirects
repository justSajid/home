# justSajid static site — Netlify _redirects
# Per-route directory → index.html rewrites
# These allow clean URLs (no .html extension) while keeping multi-page routing.

/posts/:slug        /posts/:slug/index.html        200
/categories/:slug   /categories/:slug/index.html   200
/tags/:slug         /tags/:slug/index.html          200
/blog/page/:page    /blog/page/:page/index.html     200
/blog               /blog/index.html                200
/pages/:slug        /pages/:slug/index.html         200
/search             /search.html                    200

# 404 fallback — must be LAST
/*                  /404.html                       404
